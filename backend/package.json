{
  "name": "ecommerce-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": "22.20.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "lint": "eslint src db test tests prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/platform/http/app.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=dist/app.js",
    "test:node": "tsx --test \"test/**/*.spec.ts\" \"tests/modules/buyer/*.test.ts\"",
    "test:vitest": "vitest run",
    "test": "npm run test:node && npm run test:vitest",
    "test:cross-platform": "node scripts/run-tests.js",
    "db:ci:bootstrap": "node scripts/ci-bootstrap-auth.mjs",
    "db:ci:migrate": "prisma migrate deploy",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "payload": "^3.89.0",
    "pg": "^8.23.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
