# Copy this file to .env and fill in values from ONE disposable Supabase project.
# Never commit .env, database passwords, or service-role keys.

# Supabase project settings (Dashboard > Project Settings / Connect).
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this key to the browser or NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Frontend origins allowed to call this API. Local Next.js defaults to port 3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=3001

# PostgreSQL connection strings, NOT Supabase API keys.
# DATABASE_URL: Prisma runtime, preferably the pooled connection URI.
# DIRECT_URL: Prisma Migrate, direct URI or session pooler URI; never transaction pooler.
DATABASE_URL=
DIRECT_URL=

# Remote database tests must be explicitly enabled after verifying project ref.
RUN_REMOTE_DB_TESTS=false

# PostgreSQL pool safety bounds. Keep defaults unless load testing requires a change.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=30000

# Migration safety: EXPECTED_SUPABASE_PROJECT_REF must be supplied by a human
# from the Supabase Dashboard; Luna must never derive it from DIRECT_URL.
DATABASE_ENVIRONMENT=test
EXPECTED_SUPABASE_PROJECT_REF=
ALLOW_MIGRATION_DEPLOY=false
ALLOW_STORAGE_POLICY_DEPLOY=false

# Development category fixture seed. Requires a confirmed dev/test target ref.
ALLOW_DEVELOPMENT_CATEGORY_SEED=false
