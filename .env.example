# Copy to the single root .env used by both backend and frontend. Keep real secrets out of Git.

# Backend
NODE_ENV=development
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase project (Dashboard > Project Settings)
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# PostgreSQL (runtime URL may use the pooler; DIRECT_URL must not use transaction pooling)
DATABASE_URL=
DIRECT_URL=
RUN_REMOTE_DB_TESTS=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=30000
TRUST_PROXY=

# Deployment safety. Fill the expected ref from the Dashboard only after confirming
# this is the intended disposable development/test project. Keep deploy flags false otherwise.
DATABASE_ENVIRONMENT=test
EXPECTED_SUPABASE_PROJECT_REF=
ALLOW_MIGRATION_DEPLOY=false
ALLOW_STORAGE_POLICY_DEPLOY=false
ALLOW_DEVELOPMENT_CATEGORY_SEED=false

# Frontend public configuration (Next.js loads this root file via next.config.ts)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_USE_MOCK=false
# Keep these blocked until the corresponding hosted API flow passes smoke tests.
NEXT_PUBLIC_NOTIFICATIONS_API=blocked
NEXT_PUBLIC_MEDIA_API=blocked
NEXT_PUBLIC_CAPABILITIES={}
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false

# Configure these in Supabase Dashboard > Authentication, not in this env file:
# Google provider: OAuth Client ID and Client Secret.
# Google Cloud authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# Supabase Site URL: http://localhost:3000
# Supabase Redirect URLs: http://localhost:3000/auth/callback,
#   http://localhost:3000/reset-password, http://localhost:3000/**
# SMTP (demo): smtp.gmail.com:587, Gmail username/sender, 16-character App Password.
# Never add the Google Client Secret or Gmail App Password to .env or frontend variables.
