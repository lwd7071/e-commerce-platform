# ==============================================================================
# E-COMMERCE PLATFORM - UNIFIED ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env ở thư mục root để chạy local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. SUPABASE CREDENTIALS (DÙNG CHO CẢ BACKEND & FRONTEND)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# 3. DATABASE CONNECTION (PRISMA & PG POOL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.your-project-id:password@aws-0-region.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.your-project-id:password@aws-0-region.pooler.supabase.com:5432/postgres"
RUN_REMOTE_DB_TESTS=true

# ------------------------------------------------------------------------------
# 4. FRONTEND NEXT.JS PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=true
